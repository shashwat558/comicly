# --- Copy to .env and fill in. NEVER commit .env ---
# SECURITY: the GOOGLE_API_KEY previously committed in git history is compromised. Revoke it in Google AI Studio and use a new one here.
GOOGLE_API_KEY=changeme
DATABASE_URL=postgresql+asyncpg://comicly:comicly@localhost:5432/comicly
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-change-me-in-prod
S3_BUCKET=comicly
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/comicly
FRONTEND_URL=http://localhost:3000
ENV=dev
LOG_LEVEL=INFO
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# hybrid pipeline: Flash drafts (fast/cheap) + Pro hero/sheets (quality).
# Verified 2026 model IDs: gemini-3.1-flash-image (14 refs, 2K), gemini-3-pro-image (14 refs, 2K/4K).
GEMINI_DRAFT_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_HERO_IMAGE_MODEL=gemini-3-pro-image
GEMINI_SHEET_IMAGE_MODEL=gemini-3-pro-image
# critic judge: pass threshold 0-1, max targeted retries before accept-and-flag
CRITIC_PASS_THRESHOLD=0.75
CRITIC_MAX_RETRIES=2
# ref-stack caps (Gemini takes up to 14 images per prompt)
MAX_REF_IMAGES=14
MAX_CHAR_REFS=5
MAX_STYLE_REFS=3
MAX_PREV_FRAMES=3
# optional per-book Pro spend cap in Pro calls (sheets + hero). 0 = unlimited.
MAX_PRO_CALLS_PER_BOOK=0
MAX_UPLOAD_MB=50
# true = deterministic placeholder images, no Gemini calls (frontend dev). false = real generation.
MOCK_GENERATION=false
# signing key for login tokens, generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=dev-only-change-me
ACCESS_TOKEN_MINUTES=60
